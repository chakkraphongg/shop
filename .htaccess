# ==========================================================
# DEKROYSHOP - Root Apache Configuration
# Optimized for Apache 2.4 on Shared / Free Hosting (InfinityFree)
# ==========================================================

# 1. Disable Directory Index Browsing
Options -Indexes

# 2. Block sensitive files and hidden dot files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|temp|tmp))$">
    Require all denied
</FilesMatch>

# 3. Security Headers (where allowed by hosting)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. UTF-8 Default Charset
AddDefaultCharset UTF-8

# 5. Block direct access to internal architecture directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes|sql|logs)/ - [F,L]
</IfModule>
